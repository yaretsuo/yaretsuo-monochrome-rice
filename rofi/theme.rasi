* {
    bg:               #000000;
    fg:               #ffffff;
    selected-bg:      #1a1a1a;
    selected-fg:      #ffffff;
    muted:            #666666;

    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            600px;
    border-radius:    12px;
    border:           2px;
    border-color:     #ffffff;
    background-color: @bg;
    padding:          20px;
}

mainbox {
    spacing:          10px;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    spacing:          0px;
    padding:          10px;
    children:         [ "prompt", "entry" ];
}

prompt {
    enabled:          true;
    font:             "JetBrainsMono Nerd Font 12";
    text-color:       @muted;
    padding:          0 6px 0 0;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @muted;
    text-color:        @fg;
}

listview {
    lines:            6;
    columns:          1;
    fixed-height:     true;
    dynamic:          false;
    scrollbar:        false;
    spacing:          4px;
    layout:           vertical;
}

element {
    padding:          10px 12px;
    border-radius:    10px;
    cursor:           pointer;
}

element selected.normal,
element selected.active {
    background-color: @selected-bg;
    text-color:       @selected-fg;
}

element-icon {
    size:             24px;
    padding:          0 12px 0 0;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
